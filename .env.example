NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public application URL (for OAuth callback links and email redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only credentials. Never use NEXT_PUBLIC_ for these values.
# Keep unset until a server-side worker/API needs elevated database access.
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Instagram API credentials (needed only when Instagram OAuth is implemented).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Generate a strong random key and keep it only in the deployment secret store.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Optional background scheduler shared secret; configure when the publish worker is deployed.
SCHEDULER_CRON_SECRET=
